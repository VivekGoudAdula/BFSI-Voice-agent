# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional — leave unset to use TWILIO_PHONE_NUMBER for SMS (same number for voice + SMS)
TWILIO_SMS_NUMBER=

# Text-to-speech provider: sarvam | elevenlabs
TTS_PROVIDER=sarvam

# Sarvam AI (Bulbul v3) — https://api.sarvam.ai
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER_DEFAULT=ashutosh
SARVAM_SPEAKER_EN=ashutosh
SARVAM_SPEAKER_HI=ashutosh
SARVAM_PACE=1.1

# ElevenLabs (requires Pro for library voices)
ELEVENLABS_API_KEY=
# Use a premade voice on free tier (library voices do NOT work via API on free)
# Rachel (default premade): 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_AUTO_FALLBACK_VOICE=true

# Deepgram (streaming STT)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
# multi = Hindi+English code-switching (required for Hindi callers on nova-2)
DEEPGRAM_LANGUAGE=multi

# Groq (LLM)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Campaign Engine (Phase 6)
CAMPAIGN_BATCH_SIZE=10
CAMPAIGN_CALL_INTERVAL_SECONDS=5.0
CAMPAIGN_MAX_CONCURRENT_CALLS=50

# Human Handoff (Phase 7)
HUMAN_AGENT_PHONE=
HANDOFF_ENABLED=true

# Compliance & Audit (Phase 8)
COMPLIANCE_ENABLED=true
# Shorter disclosure + consent for faster first response on phone calls
COMPLIANCE_BRIEF_MODE=true
# Hello first → detect English/Hindi from customer → continue in that language
COMPLIANCE_LANGUAGE_FIRST_FLOW=true
COMPLIANCE_DISCLOSURE_TEMPLATE=Hello. I am an AI-powered virtual assistant calling on behalf of {bank_name}.
COMPLIANCE_CONSENT_PROMPT=Do I have your permission to continue this conversation?
COMPLIANCE_RECORDING_NOTICE=This call may be monitored and recorded for quality and compliance purposes.
COMPLIANCE_RETENTION_TRANSCRIPTS_DAYS=2555
COMPLIANCE_RETENTION_AUDIT_LOGS_DAYS=2555
COMPLIANCE_RETENTION_RECORDINGS_DAYS=2555
COMPLIANCE_RETENTION_CONSENT_DAYS=2555

# MongoDB
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=voice_agent

# Application
BASE_URL=http://localhost:8000
BANK_NAME=ABC Bank
AUDIO_STORAGE_PATH=./storage/audio
LOG_LEVEL=INFO
SEED_ON_STARTUP=false
