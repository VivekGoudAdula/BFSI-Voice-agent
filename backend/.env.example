# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ElevenLabs
ELEVENLABS_API_KEY=
# Use a premade voice on free tier (library voices do NOT work via API on free)
# Rachel (default premade): 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_AUTO_FALLBACK_VOICE=true

# Deepgram (streaming STT)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Groq (LLM)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CRM Integration (Phase 5)
CRM_ENABLED=true
CRM_PROVIDER=salesforce
CRM_MOCK_MODE=true

# Salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_INSTANCE_URL=https://login.salesforce.com

# Zoho CRM
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
